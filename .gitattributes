# ===========================================================================
#  换行符与文本/二进制判定
#    - 仓库内统一存为 LF（* text=auto eol=lf），避免跨平台协作时整文件 diff
#    - shell 脚本必须是 LF，否则在 Windows/容器里会因 \r 报错；Windows 批处理用 CRLF
# ===========================================================================
* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 源码 / 文档 / 配置：统一 LF
*.java        text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.xml         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf
*.conf        text eol=lf
*.toml        text eol=lf
*.lp          text eol=lf

# 无扩展名的启动脚本
/bin/influxdb2tsfile  text eol=lf

# ===========================================================================
#  二进制：不做换行符转换、不参与文本 diff（Git 默认能识别，这里显式声明）
# ===========================================================================
*.tsfile    binary
*.tsfile.*  binary
*.jar       binary
*.class     binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary

# ===========================================================================
#  更可读的 diff：使用 Git 内置的 hunk header 规则（无需额外配置）
# ===========================================================================
*.java  diff=java
*.py    diff=python
*.sh    diff=bash

# ===========================================================================
#  GitHub 语言统计：文档目录不计入语言占比
# ===========================================================================
docs/**  linguist-documentation

# ===========================================================================
#  git archive 打包时排除开发用文件
# ===========================================================================
/.gitignore      export-ignore
/.gitattributes  export-ignore
